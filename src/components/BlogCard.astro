---
interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: string;
  category: string;
  tags: string[];
}

const { href, title, description, pubDate, category, tags } = Astro.props;
---

<article class="card blog-card">
  <div class="meta-row">
    <span class="badge badge-category">{category}</span>
    <time datetime={pubDate}>{pubDate}</time>
  </div>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  <div class="tag-list">
    {tags.map((tag) => <span class="badge badge-tag">#{tag}</span>)}
  </div>
</article>
